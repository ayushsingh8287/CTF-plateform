# Copy this file to backend/.env (never commit .env). On Render/Railway set these in the dashboard instead.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_SECRET=paste-64-random-chars-here
ADMIN_EMAIL=organizer@example.com
# generate with: npm run hash -- 'YourStrongAdminPassword'
ADMIN_PASSWORD_HASH=$2a$12$replace_with_generated_hash
NODE_ENV=development
RESEND_API_KEY=
# Optional: use a sender address verified with Resend.
MAIL_FROM=


# Flag lockout (optional): X attempts inside WINDOW seconds locks the team for LOCK seconds
# FLAG_MAX_TRIES=20
# FLAG_WINDOW_SEC=120
# FLAG_LOCK_SEC=120
